{
  "name": "dsh-agent-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent Manager for DeepSeek Harness: create, list, message, and interrupt sub-agents from the Web UI or with model-facing tools.",
  "license": "Apache-2.0",
  "author": "Baranov Grigoriy Vladimirovich",
  "homepage": "https://github.com/WatchDG/dsh-agent-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WatchDG/dsh-agent-manager.git"
  },
  "bugs": {
    "url": "https://github.com/WatchDG/dsh-agent-manager/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "subagent",
    "agents",
    "management",
    "cordis"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test test/manifest.test.mjs test/config.test.mjs test/agents.test.mjs test/tools.test.mjs test/command.test.mjs",
    "test:integration": "node --test test/integration.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
